{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  
  "AllowedHosts": "*.stage.your-company.com",
  
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver-stage.internal,1433;Database=ClubStage;User Id=club_user;Password=${DB_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=true;Encrypt=True;"
  },
  
  "Redis": {
    "Configuration": "redis-stage.internal:6379",
    "InstanceName": "ClubStage_",
    "ConnectTimeout": 5000,
    "SyncTimeout": 5000,
    "AbortOnConnectFail": false,
    "ConnectRetry": 3,
    "KeepAlive": 60,
    "DefaultDatabase": 0,
    "Password": "${REDIS_PASSWORD}"
  },
  
  "MongoDB": {
    "ConnectionString": "mongodb://mongo-stage.internal:27017",
    "DatabaseName": "ClubStage",
    "Username": "club_user",
    "Password": "${MONGO_PASSWORD}",
    "Timeout": 30
  },
  
  "Caching": {
    "Strategy": "Hybrid",
    "L1_Expiration": 5,
    "L2_Expiration": 30,
    "DefaultExpiration": 30
  },
  
  "DatabaseCache": {
    "Enabled": false,
    "DefaultExpiration": 30,
    "Comment": "Set Enabled to true to enable database query caching"
  },
  
  "Performance": {
    "EnableResponseCompression": true,
    "CompressionLevel": "Optimal",
    "EnableStaticFileCaching": true,
    "StaticFilesCacheMaxAge": 600
  },
  
  "Jwt": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "ClubStage",
    "Audience": "ClubStageUsers",
    "ExpirationMinutes": 480
  },
  
  "ObjectStorage": {
    "Provider": "S3",
    "BucketName": "club-stage-uploads",
    "Region": "us-east-1",
    "AccessKey": "${S3_ACCESS_KEY}",
    "SecretKey": "${S3_SECRET_KEY}",
    "MaxFileSize": 20971520,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".pdf", ".doc", ".docx", ".xls", ".xlsx" ]
  },
  
  "CORS": {
    "AllowedOrigins": [
      "https://club-web.stage.your-company.com",
      "https://club-bpms.stage.your-company.com"
    ]
  },
  
  "Features": {
    "EnableSwagger": true,
    "EnableDetailedErrors": true,
    "EnableSensitiveDataLogging": false
  },
  
  "HealthChecks": {
    "Enabled": true,
    "Path": "/health",
    "DetailedErrors": true
  }
}

