@addTagHelper "BotDetect.Web.Mvc.CaptchaTagHelper, BotDetect.Web.Mvc"

@using Neo.Bpms.Domain.Modeling.MetaDefinitions.ProjectDefinitions
@using Neo.Bpms.UI.MVC
@using Neo.Bpms.UI.MVC.Helpers
@using Neo.Bpms.UI.Resources.Resources
@using Club.AdminPanel.Web.ViewModels.Account
@using Neo.Bpms.Domain.Model.Project

@model LoginViewModel

@{
    ViewBag.Title = ViewTexts.LoginToSystem;
}

<div class="cando-login-container">
    <div class="cando-login-form-section">
        @using (Html.BeginForm("Login", "Account", new { ViewBag.ReturnUrl }, FormMethod.Post, false, new { @class = "cando-login-form", role = "form", autocomplete = "off" }))
        {
            @Html.AntiForgeryToken()
            HiddenFields();

            <h3 class="cando-login-title">
                پلتفرم باشگاه مشتریان
            </h3>
            <h6 class="cando-login-subtitle">
                لطفا اطلاعات ورود خود را وارد کنید
            </h6>
            
            @Html.ValidationSummary(false, "", new { @class = "cando-login-field-validation-error" })
            
            <div class="cando-login-form-group">
                <div class="cando-login-input-container">
                    <img src="@Url.Content(SpecificCommonlyNeededAssets.GetImage("leading-icon"))" class="cando-login-input-icon" alt="User Icon" />
                    @Html.TextBoxFor(m => m.UserName, new
                        {
                            @class = "cando-login-input",
                            dir = "ltr",
                            placeholder = ViewTexts.Username,
                            id = "userNameInput"
                        })
                </div>
                @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "cando-login-field-validation-error" })
            </div>
           
            @if (ProjectDefinition.Project.CaptchaInLoginEnabled)
            {
                //await RenderCaptcha();
            }
            
            <div class="cando-login-form-group">
                <input type="submit" value="@ViewTexts.LogIn" class="cando-login-submit-btn" id="loginSubmitBtn" />
            </div>
        }
    </div>
    
