@functions
{
    void HiddenFields()
    {
        var hiddenFields = ViewBag.HiddenFields as IDictionary<string, string>;
        if (hiddenFields != null)
        {
            foreach (var pair in hiddenFields)
            {
                @Html.Hidden(pair.Key, pair.Value)
            }
        }
    }

}

<script>
    const countdownElement = document.getElementById('countdown');
    const resendText = document.getElementById('resendText');
    const resendContainer = document.getElementById('resendContainer');

    let timerDuration = 125; // ثانیه
    let seconds = timerDuration;
    let timer;

    function pad(n) {
      return n.toString().padStart(2, '0');
    }

    function toPersianDigits(str) {
      return str.replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);
    }

    function updateCountdown() {
      const minutes = Math.floor(seconds / 60);
      const secs = seconds % 60;
      const timeString = `${pad(minutes)}:${pad(secs)}`;
      countdownElement.textContent = toPersianDigits(timeString);

      if (seconds > 0) {
        seconds--;
        timer = setTimeout(updateCountdown, 1000);
      } else {
        countdownElement.style.display = 'none';
        resendText.textContent = 'ارسال مجدد';
        resendContainer.classList.add('active');
        resendContainer.addEventListener('click', restartTimer);
      }
    }

    function startTimer() {
      resendContainer.classList.remove('active');
      resendText.textContent = 'تا ارسال مجدد';
      countdownElement.style.display = 'inline';
      seconds = timerDuration;
      updateCountdown();
    }

    function restartTimer() {
      resendContainer.removeEventListener('click', restartTimer);
      startTimer();
      // اینجا می‌تونی AJAX برای ارسال مجدد پیامک بزنی
      //console.log("📨 ارسال مجدد پیامک");
      //PostDataRedirect("@ViewBag.UserName" , "/Account/Login")
        $.ajax({
            type: 'POST',
            url: window.top.rootUrl+'Account/Resend',
            //contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            async: true,
            processData: true,
            cache: false,
            data: { userName: "@ViewBag.UserName"},
            headers: window.AddAntiForgeryToken(),
            success: function (res) {
                if (res) {
                    //ok
                }
            },
            error: function (e) {
                     alert(window.tetaI18n.t('Error Occured') + e.responseText);
                Error(e);
            }
        });
    }

    function PostDataRedirect(data , location) {
        var form = document.createElement("form");
        form.method = "post";
        form.action = location;
        var element1 = document.createElement("input");
        element1.type = "hidden";
        element1.value = data;
        element1.name = "UserName";
        form.appendChild(element1);
        document.body.appendChild(form);
        form.submit();
    }


    document.addEventListener("DOMContentLoaded", () => {
        startTimer();
        
        // Focus on input field
        const codeInput = document.getElementById("codeInput");
        if (codeInput) {
            codeInput.focus();
        }

        // Add loading state to submit button
        const verifyForm = document.querySelector('.cando-login-form');
        const submitBtn = document.getElementById('verifySubmitBtn');
        
        if (verifyForm && submitBtn) {
            verifyForm.addEventListener('submit', function() {
                submitBtn.classList.add('loading');
                submitBtn.disabled = true;
            });
        }

        // Add input validation styling
        if (codeInput) {
            codeInput.addEventListener('blur', function() {
                if (this.value.trim() === '') {
                    this.classList.add('error');
                } else {
                    this.classList.remove('error');
                }
            });

            codeInput.addEventListener('input', function() {
                if (this.classList.contains('error') && this.value.trim() !== '') {
                    this.classList.remove('error');
                }
            });
        }
    });
</script>
