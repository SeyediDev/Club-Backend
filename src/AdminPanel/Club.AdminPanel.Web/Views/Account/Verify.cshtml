@using Neo.Bpms.Domain.Modeling.MetaDefinitions.ProjectDefinitions
@using Neo.Bpms.UI.MVC
@using Neo.Bpms.UI.MVC.Helpers
@using Neo.Bpms.UI.Resources.Resources
@using Club.AdminPanel.Web.ViewModels.Account
@using Neo.Bpms.Domain.Model.Project

@model VerifyLoginViewModel

@{
    ViewBag.Title = ViewTexts.VerifyLoginToSystem;
}

<div class="cando-login-container">
    <div class="cando-login-form-section">
        @using (Html.BeginForm("Verify", "Account", new { ViewBag.ReturnUrl }, FormMethod.Post, false, new { @class = "cando-login-form", role = "form", autocomplete = "off" }))
        {
            @Html.AntiForgeryToken()
            HiddenFields();

            <h3 class="cando-login-title">
                پلتفرم باشگاه مشتریان
            </h3>
            <h6 class="cando-login-subtitle">
                لطفا کد تایید ارسال شده را وارد کنید
            </h6>
            
            @Html.ValidationSummary(false, "", new { @class = "cando-login-field-validation-error" })
            
            <div class="cando-login-form-group">
                <div class="cando-login-input-container">
                    <img src="@Url.Content(SpecificCommonlyNeededAssets.GetImage("123"))" class="cando-login-input-icon" alt="Code Icon" />
                    @Html.TextBoxFor(m => m.Code, new
                        {
                            @class = "cando-login-input",
                            dir = "ltr",
                            placeholder = "کد ورود",
                            id = "codeInput"
                        })
                </div>
                @Html.ValidationMessageFor(m => m.Code, "", new { @class = "cando-login-field-validation-error" })
            </div>

            <div class="cando-login-form-group">
                <div class="cando-login-resend-container" id="resendContainer">
                    <div class="cando-login-checkbox-container">
                        @Html.CheckBoxFor(m => m.RememberMe, new { @class = "cando-login-checkbox" })
                        <label class="cando-login-checkbox-label" for="RememberMe">
                            @ViewTexts.RememberMe
                        </label>
                    </div>
                    <div class="cando-login-resend-section">
                        <span class="cando-login-resend-icon" id="resendIcon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M17.6498 6.34989C16.8116 5.50416 15.7942 4.8575 14.6726 4.45768C13.551 4.05786 12.3539 3.91508 11.1698 4.03989C7.49978 4.40989 4.47978 7.38989 4.06978 11.0599C3.51978 15.9099 7.26978 19.9999 11.9998 19.9999C13.5099 19.9999 14.989 19.5714 16.2653 18.7642C17.5415 17.957 18.5626 16.8043 19.2098 15.4399C19.5298 14.7699 19.0498 13.9999 18.3098 13.9999C17.9398 13.9999 17.5898 14.1999 17.4298 14.5299C16.8492 15.7789 15.8561 16.7899 14.6177 17.3927C13.3793 17.9955 11.971 18.1534 10.6298 17.8399C8.40978 17.3499 6.61978 15.5399 6.14978 13.3199C5.95221 12.4422 5.9545 11.5312 6.15647 10.6545C6.35845 9.77775 6.75494 8.95764 7.31663 8.25481C7.87831 7.55198 8.59082 6.98442 9.40145 6.59411C10.2121 6.20379 11.1001 6.00071 11.9998 5.99989C13.6598 5.99989 15.1398 6.68989 16.2198 7.77989L14.7098 9.28989C14.0798 9.91989 14.5198 10.9999 15.4098 10.9999H18.9998C19.5498 10.9999 19.9998 10.5499 19.9998 9.99989V6.40989C19.9998 5.51989 18.9198 5.06989 18.2898 5.69989L17.6498 6.34989Z" fill="currentColor" />
                            </svg>
                        </span>
                        <span id="resendText">تا ارسال مجدد</span>
                        <span class="cando-login-countdown" id="countdown">۰۲:۰۵</span>
                    </div>
                </div>
            </div>
            
            <div class="cando-login-form-group">
                <input type="submit" value="@ViewTexts.LogIn" class="cando-login-submit-btn" id="verifySubmitBtn" />
            </div>
        }
    </div>
    
