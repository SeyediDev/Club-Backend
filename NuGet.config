<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    
    <!-- 1. NuGet.org - Public packages -->
    <add key="nuget.org" 
         value="https://api.nuget.org/v3/index.json" 
         protocolVersion="3" />
    
    <!-- 2. Nexus شخصی - Neo.Bpms (Private) -->
    <!-- TODO: Replace with your Nexus server URL after setup -->
    <add key="neo-bpms-private" 
         value="http://YOUR_UBUNTU_SERVER:8081/repository/neo-bpms/" />
    
    <!-- 3. Nexus شرکت - Club packages (Optional) -->
    <add key="club-nexus" 
         value="http://192.168.5.100/repository/nuget-hosted/" />
  </packageSources>
  
  <packageSourceCredentials>
    <neo-bpms-private>
      <add key="Username" value="javad" />
      <!-- Use environment variable for security -->
      <add key="ClearTextPassword" value="%NEO_NEXUS_TOKEN%" />
    </neo-bpms-private>
  </packageSourceCredentials>
  
  <!-- Package Source Mapping for security -->
  <packageSourceMapping>
    <!-- Neo.Bpms from private Nexus -->
    <packageSource key="neo-bpms-private">
      <package pattern="Neo.Bpms.*" />
    </packageSource>
    
    <!-- All packages (Neo, Club, others) from NuGet.org -->
    <packageSource key="nuget.org">
      <package pattern="Neo.*" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

